# Copiez ce fichier en .env (jamais versionné) — tout est facultatif si vos fichiers
# ~/.telegram_config et ~/Projects/Groq_agent/.groq_config existent déjà.

# --- Moteur IA ---
BACKEND=groq
#GROQ_API_KEY=            # sinon lue dans ~/Projects/Groq_agent/.groq_config
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# --- LLM locaux (Ollama sur le Pi5) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b                      # llama3.2:3b = plus rapide
OLLAMA_VISION_MODEL=llama3.2-vision:11b      # ou moondream (très rapide, voir README_LLM)

# --- Telegram ---
#TELEGRAM_TOKEN=          # sinon token_problemsolving dans ~/.telegram_config
# Identifiants autorisés en plus du chat_id de ~/.telegram_config (séparés par des virgules)
ALLOWED_IDS=
